{
  "name": "capacitor-statusbar-plugin",
  "version": "1.0.0",
  "description": "Forces transparency on iOS Status Bar for MABS 12 apps",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "Package.swift",
    "CapacitorStatusbarPlugin.podspec"
  ],
  "keywords": [
    "ecosystem:capacitor",
    "capacitor-plugin",
    "ios"
  ],
  "author": "Wouter Baeten <bigwouterstyle@hotmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigwouter/capacitor-statusbar-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/bigwouter/capacitor-statusbar-plugin/issues"
  },
  "scripts": {
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
